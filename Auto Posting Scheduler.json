    {
      "parameters": {
        "jsCode": "\n\n// Waktu sekarang di zona Asia/Jakarta\nconst now = DateTime.now().setZone('Asia/Jakarta');\n\nconst dueItems = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n\n  const dateStr = String(row['Scheduled Date']).trim(); // contoh: 12/10/2026\n  const timeStr = String(row['Scheduled Time']).trim(); // contoh: 9:30:00\n\n  // Gabungkan tanggal + jam, dibaca sebagai waktu Jakarta\n  const scheduled = DateTime.fromFormat(\n    `${dateStr} ${timeStr}`,\n    'd/M/yyyy H:mm:ss',\n    { zone: 'Asia/Jakarta' }\n  );\n\n  // Lanjutkan hanya jika format valid DAN jadwal sudah lewat\n  if (scheduled.isValid && scheduled <= now) {\n    dueItems.push({\n      json: {\n        ...row,\n        scheduled_iso: scheduled.toISO(),\n        now_iso: now.toISO(),\n      },\n    });\n  }\n}\n\nreturn dueItems;"
      },
